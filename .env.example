# SOTP Intelligence — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- SEC EDGAR ---
# SEC requires a descriptive User-Agent header on all requests (name + contact email).
# Example: "SOTP Intelligence research@example.com"
SEC_USER_AGENT="Your Name your-email@example.com"

# --- Database (Supabase-compatible Postgres) ---
# Required for real persistence (ingested facts, segments, valuation runs, etc).
# Example: postgresql://postgres:password@localhost:5432/sotp_intelligence
# NOTE: the backend test suite does NOT require this to be set / does not need a
# live Postgres instance -- backend/tests/conftest.py overrides DATABASE_URL with
# a throwaway per-test SQLite file automatically. Only set this for running the
# app locally or applying Alembic migrations (`alembic -c backend/alembic.ini upgrade head`).
DATABASE_URL="postgresql://postgres:password@localhost:5432/sotp_intelligence"

# --- AI layer ---
# Which AI provider backend/ai/factory.py's get_ai_adapter() constructs.
# "gemini" (default, preserves existing behavior) uses the hosted Gemini API
# and requires GEMINI_API_KEY below. "ollama" uses a local, free, unauthenticated
# Ollama installation -- requires the Ollama app installed and running
# (https://ollama.com) AND the configured model already pulled locally
# (e.g. `ollama pull llama3.1:8b`); no API key needed for Ollama.
AI_PROVIDER="gemini"

# Google Gemini API key, used by backend/ai/gemini_adapter.py.
GEMINI_API_KEY=""

# Optional: Groq API key, alternate/faster inference provider for AI layer.
GROQ_API_KEY=""

# Local Ollama service URL and model, used by backend/ai/ollama_adapter.py
# when AI_PROVIDER=ollama. Defaults match a stock local Ollama install.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1:8b"

# --- Macro data (risk-free rate suggestion for WACC) ---
# Optional. Powers GET /valuation/wacc/risk-free-rate-suggestion (a real, sourced
# US 10Y Treasury yield the analyst can choose to pre-fill into WACC -- never
# auto-applied). Free tier, no card required: https://londonstrategicedge.com/data
# If unset, this endpoint returns 503 and the risk-free rate simply stays a
# manual input, same as before this feature existed.
LSE_API_KEY=""
LSE_API_BASE_URL="https://api.londonstrategicedge.com"

# --- API authentication ---
# Every endpoint except /health requires `Authorization: Bearer <JWT>`. Tokens are
# HS256-signed with this secret and must carry `sub` (the approver / run author
# recorded in the audit trail), `exp`, and optionally `roles` (the "analyst" role
# is required to record a decision or execute a governed run).
# REQUIRED, at least 32 characters. If unset or too short, every protected
# endpoint answers 503 (the server fails closed). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=""

# --- Backend ---
# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS="http://localhost:3000"

# --- Frontend ---
# Base URL the Next.js app uses to call the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
# Frontend variables live in apps/web/.env.local (not this file). The web app
# sends NEXT_PUBLIC_API_TOKEN as its Bearer token. TODO: replace with a real
# login flow -- a NEXT_PUBLIC_ value is baked into the browser bundle, so this is
# for local development only. Mint one with:
#   python scripts/mint_dev_token.py --sub you@example.com --hours 720
# NEXT_PUBLIC_API_TOKEN=""
